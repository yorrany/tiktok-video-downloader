{
	"name": "TikFlow - TikTok Video Downloader (No Watermark)",
	"description": "Download TikTok videos without watermark in HD and extract MP3 audio directly from TikTok with one click.",
	"version": "1.0.0",
	"manifest_version": 3,
	"background": {
		"service_worker": "background.js"
	},
	"permissions": [
		"storage",
		"activeTab",
		"scripting",
		"downloads"
	],
	"host_permissions": [
		"*://*.tiktok.com/*",
		"*://tiktok.com/*",
		"*://*.tiktokcdn.com/*",
		"*://*.tiktokcdn-us.com/*",
		"*://*.tikwm.com/*"
	],
	"content_scripts": [
		{
			"matches": [
				"*://*.tiktok.com/*",
				"*://tiktok.com/*"
			],
			"js": [
				"content.js"
			],
			"css": [
				"content.css"
			],
			"run_at": "document_end"
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_title": "TikFlow - TikTok Video Downloader",
		"default_icon": {
			"16": "/images/icon16.png",
			"32": "/images/icon32.png",
			"48": "/images/icon48.png",
			"128": "/images/icon128.png"
		}
	},
	"icons": {
		"16": "/images/icon16.png",
		"32": "/images/icon32.png",
		"48": "/images/icon48.png",
		"128": "/images/icon128.png"
	}
}
