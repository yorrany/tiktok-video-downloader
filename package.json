{
	"name": "tiktok-video-downloader",
	"version": "1.0.0",
	"description": "Chrome Extension to download TikTok videos without watermark in HD and extract MP3 audio directly from tiktok.com.",
	"main": "index.js",
	"scripts": {
		"build": "webpack --config ./webpack/webpack.prod.js",
		"start": "webpack --watch --config ./webpack/webpack.dev.js",
		"package": "(cd dist; zip -r ../tiktok-downloader-v1.0.0.zip ./*)"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yorrany/tiktok-video-downloader.git"
	},
	"keywords": [
		"tiktok",
		"video",
		"downloader",
		"no-watermark",
		"mp3",
		"chrome",
		"extension"
	],
	"author": "Yorrany Braga <yorranymb@gmail.com>",
	"license": "MIT",
	"devDependencies": {
		"@types/chrome": "^0.0.177",
		"copy-webpack-plugin": "^10.2.3",
		"css-loader": "^6.6.0",
		"style-loader": "^3.3.1",
		"ts-loader": "^9.2.6",
		"typescript": "^4.5.5",
		"webpack": "^5.67.0",
		"webpack-cli": "^4.9.2",
		"webpack-merge": "^5.8.0"
	},
	"dependencies": {
		"preact": "^10.6.5"
	}
}
